generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SELLER
}

enum PaymentMethod {
  BLIK
  CARD
  TRANSFER
  CASH_ON_DELIVERY
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ProductReportReason {
  SCAM
  FAKE
  COPYRIGHT
  WRONG_CATEGORY
  OFFENSIVE
  OTHER
}

enum ProductReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum ParameterType {
  text
  number
  select
}

enum IsSeller {
  ZERO @map("0")
  ONE  @map("1")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(255)
  password          String    @db.VarChar(255)
  name              String?   @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  role              UserRole? @default(USER)
  isSuperAdmin      Boolean?  @default(false) @map("is_super_admin")
  isActive          Boolean?  @default(true) @map("is_active")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  phone             String?   @db.VarChar(9)
  passwordUpdatedAt String?   @map("password_updated_at") @db.VarChar(45)
  isSeller          IsSeller? @map("is_seller")

  addresses         Address[]
  cart              Cart?
  conversations     Conversation[] @relation("ConversationUser")
  sellerConversations Conversation[] @relation("ConversationSeller")
  favorites         Favorite[]
  messages          Message[]
  notifications     Notification[]
  orders            Order[]
  productReports    ProductReport[]
  productReviews    ProductReview[]
  refreshTokens     RefreshToken[]
  sellerProfiles    SellerProfile[]
  products          Product[] @relation("ProductSeller")

  @@map("users")
}

model Address {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  street          String    @db.VarChar(255)
  houseNumber     String?   @map("house_number") @db.VarChar(50)
  apartmentNumber String?   @map("apartment_number") @db.VarChar(50)
  postalCode      String    @map("postal_code") @db.VarChar(20)
  city            String    @db.VarChar(100)
  country         String?   @default("Polska") @db.VarChar(100)
  isDefault       Boolean?  @default(false) @map("is_default")
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_addresses_user")
  @@map("addresses")
}

model AllegroToken {
  id           Int       @id
  accessToken  String    @map("access_token") @db.Text
  refreshToken String    @map("refresh_token") @db.Text
  expiresAt    BigInt    @map("expires_at")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("allegro_token")
}

model Cart {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique(map: "carts_user_id_key") @map("user_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int       @id @default(autoincrement())
  cartId    Int       @map("cart_id")
  productId Int       @map("product_id")
  quantity  Int       @default(1)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId], map: "cart_id")
  @@index([productId])
  @@map("cart_items")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  slug      String?   @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  products      Product[]
  subcategories Subcategory[]

  @@map("categories")
}

model Conversation {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  sellerId  Int       @map("seller_id")
  productId Int?      @map("product_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  user    User     @relation("ConversationUser", fields: [userId], references: [id])
  seller  User     @relation("ConversationSeller", fields: [sellerId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  messages Message[]

  @@index([sellerId], map: "seller_id")
  @@index([productId])
  @@index([userId], map: "conversations_ibfk_1")
  @@map("conversations")
}

model Favorite {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  productId Int       @map("product_id")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId], map: "fk_favorite_user")
  @@index([productId], map: "fk_favorite_product")
  @@map("favorites")
}

model Message {
  id             Int       @id @default(autoincrement())
  conversationId Int       @map("conversation_id")
  senderId       Int       @map("sender_id")
  message        String    @db.Text
  isRead         Boolean?  @default(false) @map("is_read")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId], map: "conversation_id")
  @@index([senderId], map: "sender_id")
  @@map("messages")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String?   @db.VarChar(255)
  message   String?   @db.Text
  isRead    Boolean?  @default(false) @map("is_read")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  type      String?   @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_notifications_user")
  @@map("notifications")
}

model OrderAddress {
  id         Int       @id @default(autoincrement())
  firstName  String    @map("first_name") @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  street     String    @db.VarChar(255)
  postalCode String    @map("postal_code") @db.VarChar(20)
  city       String    @db.VarChar(100)
  country    String    @default("Polska") @db.VarChar(100)
  phone      String    @db.VarChar(20)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  userId     Int?      @map("user_id")
  orderId    Int?      @map("order_id")

  // W dumpie MySQL nie ma kluczy obcych dla user_id ani order_id.
  @@map("order_addresses")
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int     @map("order_id")
  productId   Int?    @map("product_id")
  productName String  @map("product_name") @db.VarChar(255)
  quantity    Int
  price       Decimal @db.Decimal(10, 2)
  image       String? @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "fk_order_items_orders")
  // W dumpie MySQL product_id nie ma zdefiniowanego klucza obcego.
  @@map("order_items")
}

model Order {
  id                Int           @id @default(autoincrement())
  userId            Int?          @map("user_id")
  deliveryMethod    String        @map("delivery_method") @db.VarChar(50)
  deliveryPrice     Decimal       @default(0.00) @map("delivery_price") @db.Decimal(10, 2)
  lockerId          String?       @map("locker_id") @db.VarChar(50)
  lockerName        String?       @map("locker_name") @db.VarChar(100)
  lockerAddress     String?       @map("locker_address") @db.VarChar(255)
  paymentMethod     PaymentMethod @map("payment_method")
  totalPrice        Decimal       @map("total_price") @db.Decimal(10, 2)
  status            OrderStatus   @default(NEW)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  orderNumber       String        @unique(map: "orders_order_number_key") @map("order_number") @db.VarChar(30)
  email             String?       @db.VarChar(255)
  customerName      String?       @map("customer_name") @db.VarChar(100)
  customerLastName  String?       @map("customer_last_name") @db.VarChar(100)
  customerPhone     String?       @map("customer_phone") @db.VarChar(50)
  customerStreet    String?       @map("customer_street") @db.VarChar(255)
  customerPostalCode String?      @map("customer_postal_code") @db.VarChar(20)
  customerCity      String?       @map("customer_city") @db.VarChar(100)
  customerCountry   String?       @map("customer_country") @db.VarChar(100)

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId], map: "fk_orders_users")
  @@map("orders")
}

model ParameterOption {
  id          Int    @id @default(autoincrement())
  parameterId Int    @map("parameter_id")
  value       String @db.VarChar(100)

  parameter SubcategoryParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([parameterId], map: "parameter_id")
  @@map("parameter_options")
}

model ProductImage {
  id        Int       @id @default(autoincrement())
  productId Int       @map("product_id")
  image     String    @db.VarChar(255)
  url       String    @db.VarChar(500)
  isMain    Boolean?  @default(false) @map("is_main")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "fk_product_images_product")
  @@map("product_images")
}

model ProductReport {
  id         Int                 @id @default(autoincrement())
  productId  Int                 @map("product_id")
  reporterId Int                 @map("reporter_id")
  reason     ProductReportReason
  description String?            @db.Text
  status     ProductReportStatus? @default(PENDING)
  createdAt  DateTime?           @default(now()) @map("created_at") @db.Timestamp(0)

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([reporterId], map: "reporter_id")
  @@map("product_reports")
}

model ProductReview {
  id          Int       @id @default(autoincrement())
  productId   Int       @map("product_id")
  userId      Int       @map("user_id")
  rating      Int
  comment     String?   @db.Text
  sellerReply String?   @map("seller_reply") @db.Text
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId], map: "product_reviews_product_id_user_id_key")
  @@index([userId], map: "user_id")
  @@index([productId], map: "idx_reviews_product")
  @@map("product_reviews")
}

model Product {
  id           Int       @id @default(autoincrement())
  externalId   String?   @unique(map: "products_external_id_key") @map("external_id") @db.VarChar(255)
  name         String?   @db.VarChar(255)
  description  String?   @db.Text
  price        Decimal   @db.Decimal(10, 2)
  stock        Int       @default(0)
  isVisible    Boolean   @default(true) @map("is_visible")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  productData  Json?     @map("product_data")
  attributes   Json?
  brand        String?   @db.VarChar(100)
  model        String?   @db.VarChar(100)
  sellerId     Int?      @map("seller_id")
  categoryId   Int?      @map("category_id")
  subcategoryId Int?     @map("subcategory_id")
  slug         String?   @db.Text
  type         String?   @db.VarChar(50)

  seller       User?       @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category     Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subcategory  Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cartItems    CartItem[]
  conversations Conversation[]
  favorites    Favorite[]
  images       ProductImage[]
  reports      ProductReport[]
  reviews      ProductReview[]

  @@index([price], map: "idx_price")
  @@index([stock], map: "idx_stock")
  @@index([createdAt], map: "idx_createdAt")
  @@index([categoryId], map: "fk_products_category")
  @@index([subcategoryId], map: "fk_products_subcategory")
  @@index([sellerId], map: "fk_products_seller")
  @@map("products")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @db.VarChar(500)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(0)
  isRevoked Boolean?  @default(false) @map("is_revoked")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_refresh_user")
  @@map("refresh_tokens")
}

model SellerProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  shopName    String    @map("shop_name") @db.VarChar(100)
  slug        String    @unique(map: "seller_profiles_slug_key") @db.VarChar(120)
  description String?   @db.Text
  logo        String?   @db.VarChar(255)
  path        String?   @db.VarChar(255)
  banner      String?   @db.VarChar(255)
  email       String?   @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  nip         String?   @db.VarChar(20)
  companyName String?   @map("company_name") @db.VarChar(255)
  isVerified  Boolean   @default(false) @map("is_verified")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  street      String?   @db.VarChar(255)
  city        String?   @db.VarChar(100)
  postalCode  String?   @map("postal_code") @db.VarChar(10)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "fk_seller_user")
  @@map("seller_profiles")
}

model Specification {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  subcategorySpecifications SubcategorySpecification[]

  @@map("specifications")
}

model Subcategory {
  id         Int       @id @default(autoincrement())
  categoryId Int       @map("category_id")
  name       String    @db.VarChar(100)
  slug       String?   @unique(map: "subcategories_slug_key") @db.VarChar(100)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  category      Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  products      Product[]
  parameters    SubcategoryParameter[]
  specifications SubcategorySpecification[]

  @@index([categoryId], map: "fk_subcategories_category")
  @@map("subcategories")
}

model SubcategoryParameter {
  id            Int           @id @default(autoincrement())
  subcategoryId Int           @map("subcategory_id")
  name          String        @db.VarChar(100)
  label         String        @db.VarChar(100)
  type          ParameterType? @default(text)
  required      Boolean?      @default(false)
  sortOrder     Int?          @default(0) @map("sort_order")

  subcategory Subcategory      @relation(fields: [subcategoryId], references: [id])
  options     ParameterOption[]

  @@index([subcategoryId], map: "subcategory_id")
  @@map("subcategory_parameters")
}

model SubcategorySpecification {
  id              Int @id @default(autoincrement())
  subcategoryId   Int @map("subcategory_id")
  specificationId Int @map("specification_id")

  subcategory   Subcategory   @relation(fields: [subcategoryId], references: [id])
  specification Specification @relation(fields: [specificationId], references: [id])

  @@index([subcategoryId])
  @@index([specificationId])
  @@map("subcategory_specifications")
}
